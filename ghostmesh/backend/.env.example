# GhostMesh Backend Environment Variables
# Copy to .env and fill in your API keys
# Engines marked "free" work without any key.

# ── Server config ───────────────────────────────────────────────────────────
# Port the FastAPI backend listens on (default 8080)
GHOSTMESH_PORT=8080

# ── Free engines (no key required) ─────────────────────────────────────────
# DuckDuckGo instant answers — built-in, always available
# Marginalia Search — built-in, always available (independent web index)
# URLScan.io public search — built-in, always available
# Crt.sh certificate transparency — built-in, always available

# ── Self-hosted ─────────────────────────────────────────────────────────────
# SearXNG — run your own instance: https://searxng.github.io/searxng/
SEARXNG_URL=http://localhost:8080

# ── API keys (register at each service) ─────────────────────────────────────
# Brave Search — https://api.search.brave.com (free tier available)
BRAVE_SEARCH_API_KEY=

# AlienVault OTX — https://otx.alienvault.com (free)
OTX_API_KEY=

# Shodan — https://shodan.io
SHODAN_API_KEY=

# VirusTotal — https://virustotal.com
VT_API_KEY=

# HaveIBeenPwned — https://haveibeenpwned.com/API/Key (paid plan required)
HIBP_API_KEY=

# Hunter.io — https://hunter.io
HUNTER_API_KEY=
