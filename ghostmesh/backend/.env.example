# GhostMesh Backend Environment Variables
# Copy to .env and fill in your API keys

# SearXNG (self-hosted) - optional
SEARXNG_URL=http://localhost:8080

# Shodan API key
SHODAN_API_KEY=

# VirusTotal API key
VT_API_KEY=

# HaveIBeenPwned API key (requires paid plan for full access)
HIBP_API_KEY=

# Hunter.io API key
HUNTER_API_KEY=
